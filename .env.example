# Copy to .env.local (or .env) and fill in. Never commit real values.

# ElevenLabs
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# HMAC secret from the post call webhook settings in the ElevenLabs dashboard
ELEVENLABS_WEBHOOK_SECRET=

# Shared secret sent by ElevenLabs tools in the x-haq-tool-secret header
HAQ_TOOL_SECRET=

# Password for the /staff page
STAFF_PASSWORD=

# Upstash Redis. The Vercel integration creates one of these two pairs; either works.
# Without them the app uses an in-memory store locally, and refuses to start on
# Vercel or in production.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
